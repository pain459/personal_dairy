# Personal Diary Configuration

# Port to run the application on
PORT=8888

# Database settings
DATABASE_URL=sqlite:///./diary.db

# Storage paths
DATA_DIR=/app/data
IMAGE_STORAGE_DIR=/app/data/images
THUMBNAIL_STORAGE_DIR=/app/data/thumbnails

# Logging
LOG_LEVEL=INFO

# Application version
APP_VERSION=0.1.0